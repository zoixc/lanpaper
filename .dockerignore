# Version control
.git
.gitignore
.github

# Documentation and tests. The licence notices are the exception: attribution
# has to travel with the artifact, not only with the repository.
*.md
!THIRD-PARTY-NOTICES.md
docs/
tests/

# Go test artifacts
*_test.go
*.test
*.out
go.work

# Local config and secrets
config.json
.env

# Application runtime data (mounted via volumes in production)
data/
static/images/*
!static/images/.gitkeep
static/images/previews/*
!static/images/previews/.gitkeep
external/

# IDE and OS artifacts
.vscode/
.idea/
.DS_Store
*.swp
*.swo
*~

# Docker compose files (not needed inside image)
docker-compose*.yml

# Build artifacts
/lanpaper
lanpaper.exe
